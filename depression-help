<script>
/* ==================== 页面切换 ==================== */
function switchPage(index) {
  document.querySelectorAll('.page').forEach((p, i) => {
    p.classList.toggle('active', i === index);
  });
  document.querySelectorAll('.nav button').forEach((b, i) => {
    b.classList.toggle('active', i === index);
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ==================== PHQ-9 自测 ==================== */
const phq9 = [
  "做事时提不起劲或没有兴趣",
  "感到心情低落、沮丧或绝望",
  "入睡困难、睡不安稳或睡眠过多",
  "感觉疲倦或没有活力",
  "食欲不振或吃太多",
  "觉得自己很糟，或觉得自己很失败，或让自己/家人失望",
  "对事物专注有困难，例如阅读或看电视时",
  "动作或说话速度缓慢到别人已经察觉；或正好相反，烦躁或坐立不安、动来动去的情况比平时更多",
  "有不如死掉或用某种方式伤害自己的念头"
];
const options = ["完全不会", "好几天", "一半以上天数", "几乎每天"];

// 生成题目
(function buildQuiz() {
  const container = document.getElementById('quizContainer');
  phq9.forEach((q, i) => {
    const div = document.createElement('div');
    div.className = 'quiz-item';
    div.innerHTML = `<div class="q-text">${i+1}. ${q}</div>
      <div class="quiz-options">
        ${options.map((opt, j) =>
          `<label><input type="radio" name="q${i}" value="${j}"> ${opt}</label>`
        ).join('')}
      </div>`;
    container.appendChild(div);
  });
})();

function calcQuiz() {
  let total = 0, answered = 0;
  for (let i = 0; i < 9; i++) {
    const sel = document.querySelector(`input[name="q${i}"]:checked`);
    if (sel) { total += parseInt(sel.value); answered++; }
  }
  const result = document.getElementById('quizResult');
  result.classList.add('show');

  if (answered < 9) {
    result.style.background = '#fff3cd';
    result.style.color = '#856404';
    result.innerHTML = `请回答全部 ${9} 道题目（当前已完成 ${answered} 题）。`;
    return;
  }

  let level, color, advice;
  if (total <= 4) {
    level = '无明显抑郁症状'; color = '#d4edda'; advice = '你的情绪状态整体良好。继续保持规律作息和适度运动。';
  } else if (total <= 9) {
    level = '轻度抑郁倾向'; color = '#fff3cd'; advice = '存在一些抑郁症状，建议关注自己的情绪变化，适当与信任的人倾诉，必要时可拨打心理热线咨询。';
  } else if (total <= 14) {
    level = '中度抑郁倾向'; color = '#ffe0b2'; advice = '症状比较明显，建议尽快到精神心理科就诊，或拨打12356心理援助热线获取专业建议。';
  } else if (total <= 19) {
    level = '中重度抑郁倾向'; color = '#ffccbc'; advice = '症状较为严重，强烈建议尽快前往医院精神心理科就诊，寻求专业帮助。';
  } else {
    level = '重度抑郁倾向'; color = '#ffcdd2'; advice = '症状非常严重，请立即拨打12356或前往最近医院急诊科。你不需要独自承受这一切。';
  }

  result.style.background = color;
  result.style.color = '#333';
  result.innerHTML = `<strong>你的总分：${total} / 27</strong><br>
    评估结果：<strong>${level}</strong><br>
    <span style="font-size:14px;color:#666">${advice}</span>
    <br><br><span style="font-size:12px;color:#999">⚠️ 本结果仅供筛查参考，不能作为诊断依据。请以精神心理科医生的诊断为准。</span>`;
}

/* ==================== AI 聊天 ==================== */
const chatMessages = document.getElementById('chatMessages');
const chatInput = document.getElementById('chatInput');
const sendBtn = document.getElementById('sendBtn');
const quickReplies = document.getElementById('quickReplies');

// ⚠️ 在这里填入你的 DeepSeek API Key
// 获取地址：https://platform.deepseek.com/api_keys
const API_KEY = 'sk-你的API密钥在这里';
const API_URL = 'https://api.deepseek.com/chat/completions';

// 对话历史（保留上下文）
let history = [
  {
    role: 'system',
    content: '你是一位温暖、有同理心的AI心理支持助手。你的角色是倾听、陪伴和给予情感支持，而不是做心理诊断或治疗。请用温和、接纳、不评判的语气回应用户。如果用户提到自杀或自伤，请认真对待，建议立即拨打12356心理援助热线或前往医院。每次回复控制在200字以内，适当提问引导用户表达。'
  }
];

function addMessage(text, type) {
  const div = document.createElement('div');
  div.className = `msg ${type}`;
  div.textContent = text;
  chatMessages.appendChild(div);
  chatMessages.scrollTop = chatMessages.scrollHeight;
  return div;
}

function quickSend(text) {
  chatInput.value = text;
  sendMessage();
}

async function sendMessage() {
  const text = chatInput.value.trim();
  if (!text) return;

  // 隐藏快捷回复
  quickReplies.style.display = 'none';

  // 显示用户消息
  addMessage(text, 'user');
  chatInput.value = '';
  sendBtn.disabled = true;

  // 加入对话历史
  history.push({ role: 'user', content: text });

  // 显示“正在输入”
  const typing = addMessage('正在输入...', 'bot typing');

  try {
    const response = await fetch(API_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${API_KEY}`
      },
      body: JSON.stringify({
        model: 'deepseek-chat',
        messages: history,
        temperature: 0.8,
        max_tokens: 500,
        stream: false
      })
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = await response.json();
    const reply = data.choices[0].message.content;

    typing.remove();
    addMessage(reply, 'bot');
    history.push({ role: 'assistant', content: reply });

  } catch (err) {
    typing.remove();
    addMessage('抱歉，我现在无法连接到服务器。如果你需要帮助，请拨打 12356 心理援助热线。', 'bot');
    console.error('API错误：', err);
  }

  sendBtn.disabled = false;
  chatInput.focus();
}
</script>

</body>
</html>
